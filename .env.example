# Local PostgreSQL (replace with your own user, password, host, and database).
# A postgresql:// URL is also accepted and is normalized to psycopg 3.
DATABASE_URL='postgresql+psycopg://calculator_user:password@localhost:5432/calculator'

# Comma-separated browser origins allowed by FastAPI CORS.
CORS_ORIGINS='http://localhost:5173'
ENVIRONMENT=development
